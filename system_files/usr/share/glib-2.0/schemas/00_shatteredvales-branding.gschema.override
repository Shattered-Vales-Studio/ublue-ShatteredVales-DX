# Desktop Background (Light & Dark themes)
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/shatteredvales/sv-wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/shatteredvales/sv-wallpaper.png'
picture-options='zoom'

# Lock Screen
[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/shatteredvales/sv-wallpaper.png'
picture-options='zoom'